# Documentation template only. Do not source this file or deploy it as-is.
# Mainnet parameters are gated. Keep AllowMainnet false until separate approval.
# Copy no values from staging. Put secret values in an approved secret manager
# and expose files at the *_FILE paths using the production orchestrator.

COMPOSE_PROJECT_NAME=btcpay-btcx-production
# Safe non-mainnet default for packaging/staging. Mainnet requires a separate
# authorized edit to both network settings and explicit AllowMainnet=true.
NBITCOIN_NETWORK=regtest
BTCPAYGEN_CRYPTO1=btcx
BTCPAYGEN_LIGHTNING=none
BTCPAYGEN_REVERSEPROXY=nginx
BTCPAYGEN_EXCLUDE_FRAGMENTS=opt-add-tor,btcpay-host
BTCPAYGEN_DOCKER_IMAGE=btcpayserver/docker-compose-generator:local
BTCPAY_IMAGE=registry.example.invalid/btcx/btcpayserver:0.1.0-rc2

# Public ingress names: serve only through reviewed HTTPS reverse proxies.
BTCPAY_HOST=btcpay.example.invalid
BTCPAY_ADDITIONAL_HOSTS=
LETSENCRYPT_EMAIL=ops@example.invalid
XBOARD_FQDN=shop.example.invalid

# Wallet RPC cookie is generated by the node into the private shared volume;
# BTCX plugin endpoint/wallet settings are wired by the generator fragment.
BTCX_NETWORK=regtest
BTCX_RPC_PORT=18443
BTCX_P2P_PORT=18444
BTCX_ELECTRS_NETWORK=regtest
BTCX_ELECTRUM_PORT=60401
BTCX_WALLET_NETWORK=regtest
BTCX_WALLET_NAME=btcx-production-receive
BTCX_ALLOW_MAINNET=false
BTCX_BACKEND_NETWORK=btcpay-btcx-private
BTCX_BACKEND_SUBNET=172.30.50.0/24
BTCX_P2P_NETWORK=btcpay-btcx-p2p
BTCX_DATABASE_NETWORK=btcpay-btcx-database
BTCX_NODE_IMAGE=registry.example.invalid/btcx/bitcoin-pocx:0.1.0-rc2
BTCX_ELECTRS_IMAGE=registry.example.invalid/btcx/electrs-btcx:0.1.0-rc2

# Orchestrator secret-file references; these paths contain no secret values.
POSTGRES_PASSWORD_FILE=../secrets/btcx_postgres_password
BTCPAY_GREENFIELD_TOKEN_FILE=/run/secrets/production_greenfield_token
XBOARD_WEBHOOK_HMAC_FILE=/run/secrets/production_webhook_hmac

# Operational policy values, not credentials. Set only after security review.
BTCX_CONFIRMATION_POLICY=LowSpeed
BTCX_REQUIRED_CONFIRMATIONS=6
BTCX_CNY_RATE_SOURCE=manual

# The manual 1 BTCX = X CNY quote is configured in the BTCPay plugin admin UI,
# not in this file. Keep the current rate out of source control and define
# approval, freshness, expiry, and audit policy before accepting orders.
