+    private function orderAmountCents(mixed $amount): int
+    {
+        if (!is_int($amount) || $amount <= 0 || $amount > 2_000_000_000) {
+            throw new ApiException('XBoard order amount must be a positive integer number of cents.');
+        }
+        return $amount;
+    }
