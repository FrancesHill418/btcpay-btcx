# Copy to .env, review the non-secret local network values, then create secret files
# with: ./integrations/staging/init-secrets.sh
COMPOSE_PROJECT_NAME=btcx-staging
STAGING_HTTP_BIND=127.0.0.1
STAGING_HTTP_PORT=49392
BTCPAY_DISABLE_REGISTRATION=false
BTCX_BACKEND_SUBNET=172.30.50.0/24
BTCX_BACKEND_NETWORK=btcx-staging-backend
BUILD_JOBS=2
POSTGRES_PASSWORD_FILE=./secrets/postgres-password

# Production package notes (template only): never add secret values here.
# PostgreSQL password and XBoard Greenfield/webhook secrets are delivered as
# protected files by the deployment secret manager. BTCX RPC uses the node's
# generated cookie in the private shared volume. BTCPay's generated key material
# is protected with its datadir and the BTCPay deployment's official process.
# Use integrations/production/.env.example for production candidate settings.
