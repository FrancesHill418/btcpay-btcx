<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Product>BTCX</Product>
    <Description>BTCX on-chain payments for BTCPay Server with manual BTCX/CNY pricing.</Description>
    <Version>0.1.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ProjectReference>
      <Properties>StaticWebAssetsEnabled=false</Properties>
      <Private>false</Private>
      <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BTCPayServer.Plugins.BTCX.Tests" />
    <ProjectReference Include="../../submodules/btcpayserver/BTCPayServer/BTCPayServer.csproj" />
    <EmbeddedResource Include="btcx.svg" />
    <None Update="BTCPayServer.Plugins.BTCX.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="SetBtcxRazorViewTargetPath" BeforeTargets="AssignRazorGenerateTargetPaths">
    <ItemGroup>
      <RazorGenerate Update="Views/BtcxSettings/Index.cshtml">
        <TargetPath>Plugins/BTCX/Views/BtcxSettings/Index.cshtml</TargetPath>
      </RazorGenerate>
    </ItemGroup>
  </Target>
</Project>
