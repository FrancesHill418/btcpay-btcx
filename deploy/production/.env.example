# Production template only. Replace image variables only with reviewed immutable
# registry references (name:version@sha256:digest); no production hostname, IP,
# secret value, or registry has been supplied. Keep BTCX_ALLOW_MAINNET=false.
NBITCOIN_NETWORK=mainnet
BTCPAY_IMAGE=
BTCX_NODE_IMAGE=
BTCX_ELECTRS_IMAGE=

# Operator supplies a previously created ingress network and approved CIDR.
BTCPAY_INGRESS_NETWORK=
BTCX_BACKEND_SUBNET=

# Mainnet chain parameters with wallet/payment gate deliberately off.
BTCX_NETWORK=main
BTCX_RPC_PORT=8332
BTCX_P2P_PORT=8333
BTCX_ELECTRS_NETWORK=bitcoin
BTCX_ELECTRUM_PORT=50001
BTCX_WALLET_NETWORK=main
BTCX_WALLET_NAME=btcx-production-receive
BTCX_ALLOW_MAINNET=false

# Runtime-generated PoCX RPC credentials live in private volumes.
POSTGRES_PASSWORD_FILE=./secrets/btcpay_postgres_password
